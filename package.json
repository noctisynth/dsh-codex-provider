{
  "name": "dsh-codex-provider",
  "version": "0.0.0",
  "description": "DSH provider for the official ChatGPT open-source app protocol",
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "index.cjs",
    "index.d.cts",
    "*.node",
    "client/ui/SHADCN-LICENSE.md",
    "OPENAI-BRAND.md",
    "client/ui/BASE-UI-LICENSE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "napi build --platform --js index.cjs --dts index.d.cts --release && pnpm run build:js",
    "build:js": "tailwindcss -i client/styles.css -o client/styles.generated.css --minify && tsdown",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p tsconfig.client.json --noEmit",
    "build:debug": "napi build --platform --js index.cjs --dts index.d.cts",
    "test": "node --test test/*.test.mts",
    "check": "pnpm run check:rust && pnpm run typecheck && pnpm run lint",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "check:rust": "cargo fmt --all --check && cargo clippy --all-targets --all-features -- -D warnings"
  },
  "napi": {
    "binaryName": "dsh-codex-provider",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@napi-rs/cli": "3.10.12",
    "@tailwindcss/cli": "^4.3.4",
    "@tsdown/css": "^0.23.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "18.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "tsrs": "0.22.0-ts7.1.0-beta"
  }
}
