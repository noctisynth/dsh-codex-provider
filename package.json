{
  "name": "dsh-codex-provider",
  "version": "0.0.0",
  "description": "DSH provider for the official ChatGPT open-source app protocol",
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "index.cjs",
    "index.d.cts",
    "*.node"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "napi build --platform --js index.cjs --dts index.d.cts --release && tsdown",
    "build:js": "tsdown",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p tsconfig.client.json --noEmit",
    "build:debug": "napi build --platform --js index.cjs --dts index.d.cts",
    "test": "node --test test/*.test.mts",
    "check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release"
  },
  "napi": {
    "binaryName": "dsh-codex-provider",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@napi-rs/cli": "3.10.12",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "tsdown": "^0.23.5",
    "tsrs": "0.22.0-ts7.1.0-beta"
  }
}
